# Generated by AGRr!
# Each block below is independent: delete one you do not want and the rest still work.
# No provider is named here on purpose — the rules are the ones every host that
# honours .htaccess understands.

# A request that arrives over plain HTTP is sent to the secure address rather than
# answered in the clear.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
</IfModule>

# A browser is told to keep using HTTPS, and to use it for the folders of the site too.
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" env=HTTPS
</IfModule>

# The file types the export writes that a host may not know by itself.
<IfModule mod_mime.c>
  AddType font/woff2 .woff2
  AddType image/webp .webp
  AddType image/avif .avif
  AddType application/wasm .wasm
</IfModule>

# Compression: the site's pages and stylesheets travel smaller.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml text/javascript
  AddOutputFilterByType DEFLATE application/javascript application/json application/xml
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# Cache headers: how long a browser may keep each kind of file.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/gif "access plus 30 days"
</IfModule>

# The browser is told how long it may keep each file without asking the host, and
# that it has to ask once the time is up, so a site that is exported again shows its
# changes. This header is the only answer the site gives about caching: the older
# Expires spelling above is removed for the files these rules cover, so the two never
# say different things about the same file.
<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
    Header unset Expires
  </FilesMatch>
  <FilesMatch "\.(css|js|wasm|woff2|webp|avif|png|jpg|jpeg|gif|svg|ico|xml|json|txt)$">
    Header set Cache-Control "public, max-age=3600, must-revalidate"
    Header unset Expires
  </FilesMatch>
</IfModule>

# Security headers: what a browser is told about the site's documents.
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Content Security Policy: the site may load only what it ships.
<IfModule mod_headers.c>
  Header always set Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; form-action 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self'; manifest-src 'self'"
</IfModule>

# The runtime's own files are for the server, not for a visitor: a request for one of
# them is answered with the site's own error page rather than with the file.
<IfModule mod_alias.c>
  RedirectMatch 404 ^.*/(ag-config|ag-pdo|ag-handlers|ag-routes)\.php$
</IfModule>

# The site's own error page, so a mistyped address looks like the site.
ErrorDocument 404 /404.html

# A folder answers with the index file the export wrote, so a routed page is served at
# the address its route names.
DirectoryIndex index.html

# No folder lists the files it holds.
# This sets the options of the folder rather than adding to them, so a host that needs
# an option of its own can delete this block and keep the rest.
Options -Indexes
