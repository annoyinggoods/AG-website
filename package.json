{
  "name": "annoying-goods",
  "version": "1.0.0",
  "type": "module",
  "description": "Annoying Goods — static site, dependency-free production build",
  "scripts": {
    "build": "npm run build:scripts && npm run build:site && npm run build:admin",
    "build:scripts": "tsc",
    "build:site": "node tools/build/build.mjs",
    "build:admin": "tsc -p tools/admin/tsconfig.json",
    "build:wasm": "node tools/build/build-wasm.mjs",
    "build:release": "npm run build && node tools/build/package.mjs",
    "lint": "tsc -p tsconfig.lint.json --noEmit && node tools/build/check-units.mjs",
    "typecheck": "tsc -p tsconfig.lint.json --noEmit",
    "test": "playwright test",
    "site": "node tools/build/build.mjs",
    "serve": "node tools/build/serve.mjs",
    "admin": "node tools/admin/launch.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "axe-core": "^4.14.0",
    "playwright": "^1.48.0",
    "ssh2": "^1.17.0",
    "typescript": "^5.6.0"
  }
}
